# coach-web GCP foundation — example variable values (issues #64, #66).
#
# Copy to terraform.tfvars and fill in real values. NEVER commit
# terraform.tfvars (gitignored). No secrets belong here — authentication uses
# Application Default Credentials / Workload Identity Federation, not keys
# (AC6), and API keys live in Secret Manager (AC4), populated out-of-band
# (see infra/README.md).

# GCP project hosting the stack (required — no default on purpose).
project_id = "your-gcp-project-id"

# region is pinned to europe-west6 (Zürich) by validation in variables.tf;
# Swiss data residency (nLPD) is non-negotiable (AC2).

# ---------------------------------------------------------------------------
# Container images (issue #66, AC3) — defaults shown; the deploy workflow #67
# wires environment-specific tags (dev/qa/prod/sha). Floating ':latest' is
# rejected by validation.
# ---------------------------------------------------------------------------
# coach_web_image  = "ghcr.io/fpittelo/coach-web:dev"
# coach_mcp_image  = "ghcr.io/fpittelo/coach:dev"
# github_mcp_image = "ghcr.io/github/github-mcp-server:v1.12.2"

# ---------------------------------------------------------------------------
# Secret Manager secret names (issue #66, AC4) — defaults shown. Secret
# VERSIONS are populated out-of-band with `gcloud secrets versions add`
# (procedure in infra/README.md); never place secret values in this file.
# ---------------------------------------------------------------------------
# openrouter_api_key_secret_id = "openrouter-api-key"
# intervals_api_key_secret_id  = "intervals-api-key"
# github_token_secret_id       = "github-token"

# ---------------------------------------------------------------------------
# Application configuration (cloud-specific only — review PR #93). Env entries
# duplicating the app's built-in defaults (src/coach_web/config.py) are
# intentionally NOT set in the spec; the app defaults are the single source
# of truth.
# ---------------------------------------------------------------------------
# cors_origins = "" # empty default (same-origin UI); JSON array string if a
#                     # cross-origin consumer is ever added, e.g.
#                     # cors_origins = "[\"https://coach.example.com\"]"

# ---------------------------------------------------------------------------
# WIF & OIDC
# ---------------------------------------------------------------------------

# GitHub repository scope for the WIF attribute condition (defaults shown).
# github_org  = "fpittelo"
# github_repo = "coach-web"

# ---------------------------------------------------------------------------
# Auth boundary (ADR-04, issue #68) — REQUIRED for every plan/apply
# ---------------------------------------------------------------------------
# The Cloud Run service runs with AUTH_ENABLED=true and the app-level email
# whitelist as the access-control boundary, so a Google OAuth web client ID
# is mandatory: variable validation fails `tofu plan` otherwise (fail at
# plan, not at container boot).
#
# Create the OAuth web client ONCE in the Google Cloud Console (APIs &
# Services -> Credentials -> OAuth client ID, type "Web application",
# authorized redirect URI: https://<service-url>/auth/callback), then:
#   - CI deploys: set the repo VARIABLE OIDC_CLIENT_ID (public identifier —
#     it is sent in every browser redirect to Google; not a secret) — the
#     deploy workflow passes it via -var and skips the deploy while empty.
#   - Local applies: set it here (copy this file to terraform.tfvars).
# oidc_client_id = "1234567890-abcdefg.apps.googleusercontent.com"

# Whitelist env (defaults shown — single-user personal app, the owner's own
# Google address; JSON array string, pydantic-settings parses it as JSON).
# Override only if additional Google accounts must ever gain access.
# auth_whitelist_emails = "[\"frederic.pitteloud@gmail.com\"]"

# Secret Manager secret names for the auth boundary (defaults shown). Secret
# VERSIONS are populated out-of-band with `gcloud secrets versions add`
# (one-liners in infra/README.md); never place secret values in this file.
# auth_session_secret_id        = "auth-session-secret"
# google_oauth_client_secret_id = "google-oauth-client-secret"
