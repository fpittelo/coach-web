# Coach Web — prod lane environment template (ADR-007, issue #109).
#
# This file is the prod lane's compose INTERPOLATION source — it is never
# injected into a container as a whole. docker compose reads it via
# --env-file and substitutes only the ${...} references declared in
# compose.yaml / compose.prod.yml, so every service receives exactly the
# variables scoped to it (see the environment maps in compose.yaml):
#
#   coach-web  → app config + OPENROUTER_API_KEY, GOOGLE_OIDC_CLIENT_SECRET,
#                AUTH_SESSION_SECRET, GITHUB_TOKEN
#   coach-mcp  → MCP config + INTERVALS_API_KEY
#   github-mcp → GITHUB_TOKEN (as GITHUB_PERSONAL_ACCESS_TOKEN)
#
# Usage:
#   cp .env.prod.example .env.prod  # then fill in secrets + the release digest
#   chmod 600 .env.prod
#   docker compose -p coach-web-prod -f compose.yaml -f compose.prod.yml \
#       --env-file .env.prod pull
#   docker compose -p coach-web-prod -f compose.yaml -f compose.prod.yml \
#       --env-file .env.prod up -d
#
# AUTH_ENABLED is pinned by compose.prod.yml (true — OIDC defense-in-depth)
# and is intentionally not read from this file. The app FAILS CLOSED at boot
# when auth is enabled but misconfigured, so the Google OIDC credentials and a
# lane-distinct AUTH_SESSION_SECRET (>= 32 bytes) are REQUIRED below.
# Never commit the filled-in .env.prod (gitignored). Never reuse another
# lane's env file — a dev/qa session token must not replay in prod (ADR-007).

# ---------------------------------------------------------------------------
# Release image (REQUIRED — digest-pinned)
# ---------------------------------------------------------------------------

# Resolve the digest of the released tag and record it in the release notes:
#   docker buildx imagetools inspect ghcr.io/fpittelo/coach-web:vX.Y.Z
COACH_WEB_IMAGE=ghcr.io/fpittelo/coach-web@sha256:PASTE_RELEASE_IMAGE_DIGEST_HERE

# ---------------------------------------------------------------------------
# Lane images (compose defaults shown here; override to pin)
# ---------------------------------------------------------------------------

# coach-mcp sidecar — the prod lane tracks the :prod tag (or pin a digest)
COACH_MCP_IMAGE=ghcr.io/fpittelo/coach:prod

# github-mcp sidecar — version-pinned, never :latest. For digest pinning,
# replace with ghcr.io/github/github-mcp-server@sha256:<digest of v1.12.2>.
GITHUB_MCP_IMAGE=ghcr.io/github/github-mcp-server:v1.12.2

# ---------------------------------------------------------------------------
# Secrets — scoped per service by compose.yaml (never commit real values)
# ---------------------------------------------------------------------------

# coach-web: OpenRouter API key for the coach agent LLM
OPENROUTER_API_KEY=sk-or-your_key_here

# coach-web (plan issues) + github-mcp sidecar: GitHub PAT
# Prod-lane scope: repo:read + read/write on the plan branch (approvals)
GITHUB_TOKEN=ghp_your_token_here

# coach-mcp: Intervals.icu API key
INTERVALS_API_KEY=your_api_key_here

# ---------------------------------------------------------------------------
# Google OIDC (REQUIRED on the prod lane — auth is enabled and fail-closed)
# ---------------------------------------------------------------------------

# Google OAuth 2.0 "Web application" client credentials. Register the redirect
# URI http://localhost:8000/auth/callback (and the 127.0.0.1 variant, or set
# AUTH_REDIRECT_URI explicitly — the app derives different redirect URIs for
# the two hostnames).
GOOGLE_OIDC_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_OIDC_CLIENT_SECRET=your_client_secret_here

# HS256 session signing key — DISTINCT per lane (a dev/qa session token must
# not replay in prod). Generate: openssl rand -hex 32
AUTH_SESSION_SECRET=generate_with_openssl_rand_hex_32

# Application-level whitelist (defense-in-depth; loopback binding is primary).
# An empty list rejects everyone (fail closed).
AUTH_WHITELIST_EMAILS=["frederic.pitteloud@gmail.com"]

# ---------------------------------------------------------------------------
# Optional overrides (defaults live in compose.yaml; uncomment to change)
# ---------------------------------------------------------------------------

# LOG_LEVEL=INFO
# GITHUB_REPO=fpittelo/coach
# OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# CORS_ORIGINS=["http://localhost:8000"]
# CACHE_TTL_SECONDS=60
# COACH_MCP_CACHE_TTL_SECONDS=300
# COACH_MCP_CACHE_TTL_VOLATILE_SECONDS=60
