# Coach Web — Environment Variables
# Copy this file to .env and fill in your values.

# Coach MCP Server endpoint (streamable_http transport)
# The Coach MCP server must be running with MCP_TRANSPORT=streamable_http
COACH_MCP_URL=http://localhost:8000/mcp

# GitHub Personal Access Token (for fetching training plan issues)
# Required scope: repo:read (or public_repo if the coach repo is public)
GITHUB_TOKEN=ghp_your_token_here

# GitHub repository for training plans (owner/name format)
GITHUB_REPO=fpittelo/coach

# Streamlit server configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0

# Cache TTL in seconds (for @st.cache_data)
CACHE_TTL_SECONDS=60

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
