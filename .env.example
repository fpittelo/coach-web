# Coach Web — Environment Variables
# Copy this file to .env and fill in your values.
#
# This catalogue serves the NON-Docker dev flow (uv run coach-web reads .env
# directly). The Docker lanes (ADR-007) use per-lane templates instead:
#   cp .env.dev.example .env.dev   # (or .env.qa.example / .env.prod.example)
# Those are compose --env-file interpolation sources with per-service secret
# scoping — never a shared file injected into all containers.

# ---------------------------------------------------------------------------
# Coach Web Application
# ---------------------------------------------------------------------------

# ASGI (uvicorn) server binding
APP_HOST=0.0.0.0
APP_PORT=8000

# Allowed browser origins for cross-origin requests (JSON array)
CORS_ORIGINS=["http://localhost:8000"]

# ---------------------------------------------------------------------------
# Google OIDC Authentication (issue #65) — opt-in, default OFF for local dev
# ---------------------------------------------------------------------------
# When AUTH_ENABLED=true the app enforces a default-deny whitelist boundary:
# only whitelisted Google accounts may obtain a session; /api/* returns 401
# without one. The email whitelist IS the access-control boundary (Swiss nLPD).
# Misconfigured auth (enabled but missing credentials) refuses to boot.

# Master switch: false keeps local dev identical to the pre-auth behaviour
AUTH_ENABLED=false

# Google OAuth 2.0 "Web application" client credentials (Google Cloud Console).
# The authorized redirect URI is <public-base-url>/auth/callback
# (or set AUTH_REDIRECT_URI explicitly when behind a proxy).
GOOGLE_OIDC_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_OIDC_CLIENT_SECRET=your_client_secret_here
GOOGLE_OIDC_ISSUER=https://accounts.google.com

# JSON array of allowed Google account emails (the security boundary).
# An empty list rejects everyone (fail closed).
AUTH_WHITELIST_EMAILS=["frederic.pitteloud@gmail.com"]

# HS256 signing key for stateless session cookies (generate e.g. with
# `openssl rand -hex 32`). Env var only — never logged, never committed.
# DISTINCT per lane: a dev/qa session token must not replay in prod.
AUTH_SESSION_SECRET=generate_with_openssl_rand_hex_32

# Stateless session lifetime in seconds (short-lived by design)
AUTH_SESSION_TTL_SECONDS=3600

# Optional explicit OAuth redirect URI; derived from the request when empty
AUTH_REDIRECT_URI=

# Secure flag on the session & OIDC-state cookies (default true).
# Chromium >=89 and Firefox >=75 treat http://localhost as trustworthy and DO
# send Secure cookies over plain-HTTP loopback; Safari does not (known
# limitation). NEVER set false except for a plain-HTTP non-loopback deployment.
AUTH_COOKIE_SECURE=true

# Host header allowlist (DNS-rebinding mitigation). JSON array; keep loopback
# names only unless a real reverse proxy fronts the app.
TRUSTED_HOSTS=["localhost", "127.0.0.1"]

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Cache TTL in seconds (for fetched MCP / GitHub data)
CACHE_TTL_SECONDS=60

# Maximum agent tool-calling iterations per user turn
AGENT_MAX_TOOL_ITERATIONS=8

# ---------------------------------------------------------------------------
# Sidecar MCP Servers (Docker Compose service discovery on coach-net)
# ---------------------------------------------------------------------------

# Coach MCP Server endpoint (Intervals.icu gateway, SSE transport)
# Resolved inside the compose network via the coach-mcp service name.
COACH_MCP_URL=http://coach-mcp:8000/sse

# GitHub MCP Server endpoint (streamable HTTP on coach-net)
# The official github-mcp-server image exposes streamable HTTP at the root path.
GITHUB_MCP_URL=http://github-mcp:8001/

# ---------------------------------------------------------------------------
# GitHub Configuration
# ---------------------------------------------------------------------------

# GitHub Personal Access Token (for fetching training plan issues and github-mcp)
# Required scope: repo:read (or public_repo if the coach repo is public)
# This token is also forwarded to the github-mcp sidecar as GITHUB_PERSONAL_ACCESS_TOKEN.
GITHUB_TOKEN=ghp_your_token_here

# GitHub repository for training plans (owner/name format)
GITHUB_REPO=fpittelo/coach

# Branch and directory receiving approved Markdown training plans
GITHUB_PLAN_BRANCH=main
GITHUB_PLAN_DIR=plans

# Comma-separated toolsets enabled in the github-mcp sidecar.
# See https://github.com/github/github-mcp-server#tool-configuration
GITHUB_TOOLSETS=default

# ---------------------------------------------------------------------------
# OpenRouter Configuration (coach agent LLM)
# ---------------------------------------------------------------------------

# OpenRouter API key for the coach agent (never commit a real value)
OPENROUTER_API_KEY=sk-or-your_key_here

# OpenRouter API base URL and default model
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Timeout (seconds) for a single OpenRouter completion request
OPENROUTER_TIMEOUT_SECONDS=60

# OpenRouter attribution headers
OPENROUTER_APP_TITLE=Coach Web
OPENROUTER_REFERER=https://github.com/fpittelo/coach-web

# ---------------------------------------------------------------------------
# Coach MCP Server Configuration (coach-mcp sidecar)
# ---------------------------------------------------------------------------

# Container image for the coach-mcp sidecar (lane tag: dev/qa/prod)
COACH_MCP_IMAGE=ghcr.io/fpittelo/coach:dev

# Intervals.icu API credentials
INTERVALS_API_KEY=your_api_key_here
INTERVALS_ATHLETE_ID=0
INTERVALS_BASE_URL=https://intervals.icu/api/v1

# MCP transport and binding for the sidecar (do not change for compose topology)
MCP_TRANSPORT=sse
MCP_HOST=0.0.0.0
MCP_PORT=8000

# HTTP client behaviour
HTTP_TIMEOUT_SECONDS=30.0
HTTP_MAX_RETRIES=3

# Sidecar cache TTLs. These names are interpolated by compose.yaml into the
# coach-mcp container's CACHE_TTL_SECONDS / CACHE_TTL_VOLATILE_SECONDS, so they
# never collide with the app's CACHE_TTL_SECONDS above (python-dotenv last-wins).
COACH_MCP_CACHE_TTL_SECONDS=300
COACH_MCP_CACHE_TTL_VOLATILE_SECONDS=60

# ---------------------------------------------------------------------------
# Persistence (MADR-008, #166)
# ---------------------------------------------------------------------------

# SQLite database file inside the lane volume; the WAL side files live
# alongside. Default matches the compose.yaml volume mount at /data.
COACH_DB_PATH=/data/coach.db

# ---------------------------------------------------------------------------
# GitHub MCP Server Configuration (github-mcp sidecar)
# ---------------------------------------------------------------------------

# Container image for the github-mcp sidecar — version-pinned, never :latest
GITHUB_MCP_IMAGE=ghcr.io/github/github-mcp-server:v1.12.2
