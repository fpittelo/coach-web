# Coach Web — dev lane environment template (ADR-007, issue #109).
#
# This file is the dev lane's compose INTERPOLATION source — it is never
# injected into a container as a whole. docker compose reads it via
# --env-file and substitutes only the ${...} references declared in
# compose.yaml / compose.dev.yml, so every service receives exactly the
# variables scoped to it (see the environment maps in compose.yaml):
#
#   coach-web  → app config + OPENROUTER_API_KEY, GOOGLE_OIDC_CLIENT_SECRET,
#                AUTH_SESSION_SECRET, GITHUB_TOKEN
#   coach-mcp  → MCP config + INTERVALS_API_KEY
#   github-mcp → GITHUB_TOKEN (as GITHUB_PERSONAL_ACCESS_TOKEN)
#
# Usage:
#   cp .env.dev.example .env.dev    # then fill in your secrets
#   chmod 600 .env.dev
#   docker compose -p coach-web-dev -f compose.yaml -f compose.dev.yml \
#       --env-file .env.dev up -d --build
#
# AUTH_ENABLED is pinned by compose.dev.yml (false on the dev lane) and is
# intentionally not read from this file. Never commit the filled-in .env.dev
# (gitignored). Never reuse this file for the qa/prod lanes — secrets and
# session material are lane-scoped (ADR-007).

# ---------------------------------------------------------------------------
# Lane images (compose defaults shown here; override to pin)
# ---------------------------------------------------------------------------

# coach-mcp sidecar — the dev lane tracks the :dev tag
COACH_MCP_IMAGE=ghcr.io/fpittelo/coach:dev

# github-mcp sidecar — version-pinned, never :latest. The prod lane pins the
# same release by digest (see .env.prod.example); dev/qa stay tag-pinned.
GITHUB_MCP_IMAGE=ghcr.io/github/github-mcp-server:v1.12.2

# ---------------------------------------------------------------------------
# Secrets — scoped per service by compose.yaml (never commit real values)
# ---------------------------------------------------------------------------

# coach-web: OpenRouter API key for the coach agent LLM
OPENROUTER_API_KEY=sk-or-your_key_here

# coach-web (plan issues) + github-mcp sidecar: GitHub PAT
# Dev-lane scope: repo:read (or public_repo if the plan repo is public)
GITHUB_TOKEN=ghp_your_token_here

# coach-mcp: Intervals.icu API key
INTERVALS_API_KEY=your_api_key_here

# ---------------------------------------------------------------------------
# Auth material — lane-scoped (REQUIRED if AUTH_ENABLED is ever turned on)
# ---------------------------------------------------------------------------
# AUTH_ENABLED is pinned false on the dev lane (compose.dev.yml). The session
# signing key is still declared here so enabling auth on this lane can never
# accidentally reuse another lane's key: a dev/qa session token must not replay
# in prod. Generate a DISTINCT value per lane:
#   openssl rand -hex 32
AUTH_SESSION_SECRET=generate_with_openssl_rand_hex_32

# Secure flag on session & OIDC-state cookies (default true). Chromium/Firefox
# send Secure cookies over http://localhost; Safari does not. NEVER set false
# except for a plain-HTTP non-loopback deployment.
AUTH_COOKIE_SECURE=true

# Host header allowlist (DNS-rebinding mitigation).
TRUSTED_HOSTS=["localhost", "127.0.0.1"]

# ---------------------------------------------------------------------------
# Optional overrides (defaults live in compose.yaml; uncomment to change)
# ---------------------------------------------------------------------------

# LOG_LEVEL=DEBUG
# GITHUB_REPO=fpittelo/coach
# GITHUB_PLAN_BRANCH=main
# GITHUB_PLAN_DIR=plans
# OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# CORS_ORIGINS=["http://localhost:8100"]   # dev lane default (compose.dev.yml)
# CACHE_TTL_SECONDS=60
# COACH_MCP_CACHE_TTL_SECONDS=300
# COACH_MCP_CACHE_TTL_VOLATILE_SECONDS=60
