# Coach Web — boot-persistent supervision of the prod lane (systemd USER unit
# TEMPLATE; MADR-0024, issue #328).
#
# This file is the repo-tracked source of truth. scripts/prod-install.sh
# replaces @REPO_ROOT@ with the absolute path of the checkout and writes the
# result to ~/.config/systemd/user/coach-web.service — never hand-edit the
# installed copy; re-run the installer to refresh it.
#
# Security conditions binding on this unit (fpittelo/coach-web#327):
#   C3 — the lane start and stop take the SAME shared prod-lane lock as the
#        auto-update tick (#326), the preflight and the manual rollback. This
#        unit is a second writer of the coach-web-prod project: without the lock,
#        an `up -d` landing inside a tick could recreate the lane on an image the
#        update gate has not verified yet. `-w 900` waits for an in-flight tick;
#        `-n` would instead skip the start, which is wrong for a boot unit.
#   C4 — no secret in the unit. .env.prod is handed to compose via --env-file
#        only (never EnvironmentFile=), and `docker compose config` is never
#        run or logged.
#   C5 — the hygiene set below: NoNewPrivileges, PrivateTmp, UMask, explicit
#        PATH, Restart + StartLimit*, TimeoutStartSec above the retry window.
#   C7 — linger (set/enforced by the installer) widens boot scope to every
#        enabled user unit; the installer prints that audit list.

[Unit]
Description=Coach Web prod lane (docker compose project coach-web-prod)
Documentation=file://@REPO_ROOT@/docs/admin_guide.md
# Docker is a *system* unit; a user unit cannot order against it (MADR-0024).
# The daemon race is handled by the bounded readiness retry in ExecStartPre.
# StartLimit* live in [Unit] (their modern systemd location).
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=@REPO_ROOT@
# Explicit PATH (C5): the user manager inherits a minimal environment, so the
# docker CLI and /bin/sh must be found without relying on the login PATH.
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
NoNewPrivileges=yes
PrivateTmp=yes
UMask=0077
# Bounded docker-readiness wait: 30 attempts x 2 s = 60 s of retrying, which
# must fit inside TimeoutStartSec below (the default 90 s would SIGTERM the
# loop and leave the lane down).
ExecStartPre=/bin/sh -c 'for _ in $(seq 1 30); do /usr/bin/docker info >/dev/null 2>&1 && exit 0; sleep 2; done; echo "coach-web: docker daemon not ready after 60s" >&2; exit 1'
# C3: the shared prod-lane lock (same file the update tick, the preflight and the
# manual rollback take). The wait is bounded so a boot start cannot hang forever.
ExecStart=/usr/bin/flock -w 900 /run/user/%U/coach-web-prod.lock /usr/bin/docker compose -p coach-web-prod -f @REPO_ROOT@/compose.yaml -f @REPO_ROOT@/compose.prod.yml --env-file @REPO_ROOT@/.env.prod up -d --remove-orphans
# Honest `systemctl --user stop`: project-scoped teardown, no orphans. Named
# volumes are kept (no -v), so coach-web-prod_coach-data survives a stop. It too
# takes the lock (C3) so a stop cannot interleave with an in-flight update.
ExecStop=/usr/bin/flock -w 900 /run/user/%U/coach-web-prod.lock /usr/bin/docker compose -p coach-web-prod -f @REPO_ROOT@/compose.yaml -f @REPO_ROOT@/compose.prod.yml --env-file @REPO_ROOT@/.env.prod down --remove-orphans
# Both timeouts sit above the 900 s lock wait (plus the 60 s docker-readiness
# retry), otherwise systemd would SIGTERM the wait before it gave up.
TimeoutStartSec=1200
TimeoutStopSec=1200
Restart=on-failure

[Install]
WantedBy=default.target
