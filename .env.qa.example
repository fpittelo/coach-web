# Coach Web — qa lane environment template (ADR-007, issue #109).
#
# This file is the qa lane's compose INTERPOLATION source — it is never
# injected into a container as a whole. docker compose reads it via
# --env-file and substitutes only the ${...} references declared in
# compose.yaml / compose.qa.yml, so every service receives exactly the
# variables scoped to it (see the environment maps in compose.yaml):
#
#   coach-web  → app config + OPENROUTER_API_KEY, GOOGLE_OIDC_CLIENT_SECRET,
#                AUTH_SESSION_SECRET, GITHUB_TOKEN
#   coach-mcp  → MCP config + INTERVALS_API_KEY
#   github-mcp → GITHUB_TOKEN (as GITHUB_PERSONAL_ACCESS_TOKEN)
#
# Usage:
#   cp .env.qa.example .env.qa      # then fill in your secrets
#   chmod 600 .env.qa
#   docker compose -p coach-web-qa -f compose.yaml -f compose.qa.yml \
#       --env-file .env.qa pull
#   docker compose -p coach-web-qa -f compose.yaml -f compose.qa.yml \
#       --env-file .env.qa up -d
#
# Precondition: the :qa images exist only after the first post-change
# dev → qa promotion (ghcr.io/fpittelo/coach-web:qa and the coach repo's
# ghcr.io/fpittelo/coach:qa). Until then the qa lane pull fails by design.
#
# AUTH_ENABLED is pinned by compose.qa.yml (false on the qa lane) and is
# intentionally not read from this file. Never commit the filled-in .env.qa
# (gitignored). Never reuse another lane's env file — secrets and session
# material are lane-scoped (ADR-007).

# ---------------------------------------------------------------------------
# Lane images (compose defaults shown here; override to pin)
# ---------------------------------------------------------------------------

# coach-mcp sidecar — the qa lane tracks the :qa tag (CI-built)
COACH_MCP_IMAGE=ghcr.io/fpittelo/coach:qa

# github-mcp sidecar — version-pinned, never :latest
GITHUB_MCP_IMAGE=ghcr.io/github/github-mcp-server:v1.12.2

# ---------------------------------------------------------------------------
# Secrets — scoped per service by compose.yaml (never commit real values)
# ---------------------------------------------------------------------------

# coach-web: OpenRouter API key for the coach agent LLM
OPENROUTER_API_KEY=sk-or-your_key_here

# coach-web (plan issues) + github-mcp sidecar: GitHub PAT
# Qa-lane scope: repo:read (or public_repo if the plan repo is public)
GITHUB_TOKEN=ghp_your_token_here

# coach-mcp: Intervals.icu API key
INTERVALS_API_KEY=your_api_key_here

# ---------------------------------------------------------------------------
# Optional overrides (defaults live in compose.yaml; uncomment to change)
# ---------------------------------------------------------------------------

# LOG_LEVEL=INFO
# GITHUB_REPO=fpittelo/coach
# OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# CORS_ORIGINS=["http://localhost:8200"]
# CACHE_TTL_SECONDS=60
# COACH_MCP_CACHE_TTL_SECONDS=300
# COACH_MCP_CACHE_TTL_VOLATILE_SECONDS=60
